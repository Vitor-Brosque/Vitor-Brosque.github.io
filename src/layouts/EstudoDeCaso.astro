---
import Base from './Base.astro';
import Estrada from '../components/Estrada.astro';
import Rota from '../components/Rota.astro';
import MolduraMidia from '../components/MolduraMidia.astro';
import Decisao from '../components/Decisao.astro';
import MapaArquitetura from '../components/MapaArquitetura.tsx';
import CenaRpg from '../components/rpg/CenaRpg.astro';
import Estagios from '../components/rpg/Estagios.astro';
import LogTerminal from '../components/terminal/LogTerminal.astro';
import type { Projeto } from '../lib/projetos';
import { slugDe } from '../lib/projetos-puro';
import { paragrafos, textoRico } from '../lib/texto';
import { t, urlDaHome, urlDoProjeto, type Idioma } from '../i18n/ui';
import '@fontsource/pixelify-sans/latin-400.css';
import '../styles/tema-rpg.css';
import pixelify400 from '@fontsource/pixelify-sans/files/pixelify-sans-latin-400-normal.woff2?url';
import '../styles/tema-terminal.css';
import mono400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import mono700 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2?url';

interface Props { projeto: Projeto; proximo: Projeto; idioma: Idioma }
const { projeto, proximo, idioma } = Astro.props;
const d = projeto.data;
const slug = slugDe(projeto.id);
// Capa com moldura de navegador: recorte 16/10 para não ficar altíssima com prints em retrato.
const capa = d.capa && d.capa.moldura === 'navegador' ? { ...d.capa, proporcao: '16/10' as const } : d.capa;
const site = Astro.site ?? new URL('https://vitor-brosque.github.io');
const tema = d.tema;
const rpg = tema === 'rpg';
const terminal = tema === 'terminal';
/** Fontes da primeira dobra a pré-carregar por tema (o título não troca de fonte depois de aparecer). */
const fontesDoTema: Record<typeof tema, string[]> = { rodovia: [], rpg: [pixelify400], terminal: [mono700, mono400] };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.titulo,
  description: d.seo.descricao,
  inLanguage: idioma === 'pt' ? 'pt-BR' : 'en',
  url: new URL(urlDoProjeto(idioma, slug), site).href,
  author: { '@type': 'Person', name: 'Vitor Brosque', url: site.href },
};
---
<Base titulo={`${d.titulo} · Vitor Brosque`} descricao={d.seo.descricao} idioma={idioma} imagemOg={d.capa?.imagem} altOg={d.capa?.alt} jsonLd={jsonLd} fontes={fontesDoTema[tema]}>
  <main id="conteudo" data-tema={tema}>
    {/* Nos temas próprios a leitura enche uma barra presa ao pé da navegação (a de XP no rpg, a de progresso no terminal;
        leitura.ts; sem JS não aparece). */}
    {tema !== 'rodovia' && <div class="leitura" data-leitura aria-hidden="true"><span class="leitura-cheio"></span></div>}
    <header class="wrap caso-topo">
      <a class="voltar" data-entrada style="--ordem: 0" href={urlDaHome(idioma, 'projetos')}>← {t(idioma, 'caso.voltar')}</a>
      <p class="rotulo rotulo--sinal" data-entrada style="--ordem: 0">{d.statusTexto}</p>
      <h1 transition:name={`titulo-${slug}`}>{d.titulo}</h1>
      {rpg && <div class="caso-cena" data-entrada style="--ordem: 1"><CenaRpg /></div>}
      {terminal && d.logDoTopo && <div class="caso-log" data-entrada style="--ordem: 1"><LogTerminal idioma={idioma} linhas={d.logDoTopo} /></div>}
      <p class="caso-frase" data-entrada style="--ordem: 2">{d.frase}</p>
      <dl class="ficha" data-entrada style="--ordem: 3">
        <div><dt class="rotulo">{t(idioma, 'caso.papel')}</dt><dd>{d.papel}</dd></div>
        <div><dt class="rotulo">{t(idioma, 'caso.periodo')}</dt><dd>{d.periodo}</dd></div>
        <div class="ficha-stack"><dt class="rotulo">{t(idioma, 'caso.stack')}</dt><dd><ul class="chips">{d.stack.map((s) => <li>{s}</li>)}</ul></dd></div>
      </dl>
      <div class="acoes" data-entrada style="--ordem: 4">
        {d.links.codigo && <a class="botao botao--sinal" href={d.links.codigo}>{t(idioma, 'caso.codigo')}</a>}
        {d.links.vitrine && <a class="botao" href={d.links.vitrine}>{t(idioma, 'caso.vitrine')}</a>}
      </div>
      {d.links.vitrine && !d.links.codigo && <p class="vitrine-nota" data-entrada style="--ordem: 4">{t(idioma, 'caso.vitrineNota')}</p>}
    </header>

    <section class="wrap em-resumo-secao" aria-labelledby="em-resumo">
      <div class="em-resumo" data-entrada style="--ordem: 5">
        {terminal && <div class="janela-barra" aria-hidden="true"><i></i><i></i><i></i><span>{t(idioma, 'terminal.resumo')}</span></div>}
        <h2 id="em-resumo" class="em-resumo-titulo">{t(idioma, 'caso.emResumo')}</h2>
        <p class="em-resumo-texto" set:html={textoRico(d.emResumo)} />
        {d.numeros.length > 0 && (
          <dl class="numeros">
            {d.numeros.map((n, i) => <div data-entrada style={`--ordem: ${6 + i}`}><dt>{n.valor}</dt><dd>{n.rotulo}</dd></div>)}
          </dl>
        )}
        {d.numeros.length > 0 && d.numerosFonte && <p class="numeros-fonte">{d.numerosFonte}</p>}
      </div>
    </section>

    {capa && <div class="wrap caso-capa revelar revelar--zoom"><MolduraMidia midia={capa} idioma={idioma} sizes="(min-width: 1120px) 1040px, 92vw" /></div>}

    <div class="caso-estrada"><Estrada tema={tema} idioma={idioma} /></div>

    <section class="secao wrap" aria-labelledby="problema">
      <h2 id="problema" class="revelar">{t(idioma, 'caso.problema')}</h2>
      <div class="texto caso-texto revelar">{paragrafos(d.problema).map((p) => <p set:html={textoRico(p)} />)}</div>
    </section>

    <section class="secao wrap" aria-labelledby="rota">
      <h2 id="rota" class="revelar">{d.rota.titulo}</h2>
      <div class="caso-rota"><Rota titulo={d.rota.titulo} paradas={d.rota.paradas} modo="rolagem" idioma={idioma} tema={tema} /></div>
    </section>

    {d.funcionalidades.length > 0 && (
      <section class="secao wrap" aria-labelledby="faz">
        <h2 id="faz" class="revelar">{t(idioma, 'caso.oQueFaz')}</h2>
        <ul class="funcs">
          {d.funcionalidades.map((f) => (
            <li class="revelar">
              <MolduraMidia midia={f.midia} idioma={idioma} sizes="(min-width: 900px) 33vw, 92vw" />
              <h3>{f.titulo}</h3>
              <p set:html={textoRico(f.texto)} />
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="secao wrap" aria-labelledby="detalhes">
      <h2 id="detalhes" class="revelar">{t(idioma, 'caso.detalhes')}</h2>
      <p class="secao-intro revelar">{t(idioma, 'caso.detalhesIntro')}</p>

      {d.arquitetura && (
        <details class="arquitetura recolhivel revelar">
          <summary>
            <span class="resumo-titulo">{d.arquitetura.titulo}</span>
            <span class="resumo-texto" set:html={textoRico(d.arquitetura.texto)} />
            <span class="resumo-icone" aria-hidden="true"></span>
          </summary>
          <div class="arquitetura-corpo recolhivel-corpo">
            <MapaArquitetura
              client:visible
              nos={d.arquitetura.nos}
              faixas={d.arquitetura.faixas}
              rotulo={t(idioma, 'mapa.rotulo')}
              dica={t(idioma, 'mapa.dica')}
              todas={t(idioma, 'mapa.todas')}
            />
          </div>
        </details>
      )}

      <h3 class="decisoes-titulo revelar">{t(idioma, 'caso.decisoes')}</h3>
      <div class="decisoes">{d.decisoes.map((dec) => <Decisao decisao={dec} idioma={idioma} tema={tema} />)}</div>
    </section>

    {rpg && d.hoje ? (
      <section class="secao wrap" aria-labelledby="estagios">
        <h2 id="estagios" class="revelar">{t(idioma, 'caso.estagios')}</h2>
        <Estagios idioma={idioma} hoje={d.hoje} proximos={d.proximos} />
      </section>
    ) : d.proximos.length > 0 && (
      <section class="secao wrap" aria-labelledby="proximos">
        <h2 id="proximos" class="revelar">{t(idioma, 'caso.proximos')}</h2>
        <ul class="proximos revelar">{d.proximos.map((p) => <li set:html={textoRico(p)} />)}</ul>
      </section>
    )}

    <nav class="secao wrap revelar" aria-label={t(idioma, 'caso.proximoProjeto')}>
      <a class="proximo" href={urlDoProjeto(idioma, slugDe(proximo.id))}>
        <span class="rotulo">{t(idioma, 'caso.proximoProjeto')} →</span>
        <strong>{proximo.data.titulo}</strong>
        <span class="proximo-frase">{proximo.data.frase}</span>
      </a>
    </nav>
  </main>
</Base>
<style>
  .caso-topo { padding-top: clamp(28px, 5vw, 56px); }
  .voltar { display: inline-block; margin-bottom: 26px; color: var(--mute); text-decoration: none; font-size: 0.95rem; }
  .voltar:hover { color: var(--ink); }
  h1 { margin-top: 10px; font-size: clamp(1.9rem, 9.2vw, 3.2rem); }
  @media (min-width: 640px) { h1 { font-size: clamp(2.75rem, 7vw, 5rem); } }
  .caso-frase { margin-top: 14px; max-width: 50ch; font-size: clamp(1.1rem, 1.8vw, 1.35rem); color: var(--ink-2); }
  .vitrine-nota { margin-top: 12px; max-width: var(--medida); color: var(--mute); font-size: 0.85rem; }
  .ficha { display: grid; grid-template-columns: repeat(3, minmax(0, auto)); gap: 18px 32px; margin: 28px 0 0; justify-content: start; }
  .ficha dd { margin: 4px 0 0; }
  .ficha-stack { grid-column: 1 / -1; }
  .acoes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .em-resumo-secao { margin-top: clamp(32px, 5vw, 52px); }
  .em-resumo { padding: clamp(20px, 3.5vw, 36px); background: var(--bg-2); border: 1px solid var(--line); border-left: 4px solid var(--signal); border-radius: var(--raio); }
  .em-resumo-titulo { font-size: clamp(1.35rem, 2.4vw, 1.6rem); font-stretch: 125%; font-weight: 850; letter-spacing: -0.005em; color: var(--ink); }
  .em-resumo-titulo::before { content: ''; display: inline-block; width: 12px; height: 12px; margin-right: 12px; background: var(--signal); vertical-align: 0.05em; }
  .em-resumo-texto { margin-top: 12px; max-width: var(--medida); color: var(--ink); font-size: clamp(1.05rem, 1.6vw, 1.2rem); }
  .caso-capa { margin-top: 40px; }
  .caso-estrada { margin-top: clamp(48px, 8vw, 88px); }
  .caso-texto { margin-top: 18px; font-size: 1.1rem; }
  .caso-rota { margin-top: 22px; }
  .funcs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 28px 22px; margin: 26px 0 0; padding: 0; list-style: none; }
  .funcs h3 { margin-top: 14px; font-size: 1.15rem; }
  .funcs p { margin-top: 6px; color: var(--ink-2); font-size: 0.95rem; }
  .arquitetura { margin-top: 26px; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--raio); }
  .arquitetura-corpo { padding: 4px clamp(12px, 3vw, 24px) clamp(16px, 3vw, 24px); }
  .decisoes-titulo { margin-top: clamp(32px, 5vw, 48px); font-size: 1.25rem; }
  .decisoes { display: grid; gap: 12px; margin-top: 16px; }
  .numeros { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 18px; margin: 24px 0 0; }
  .numeros dt { font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 850; font-stretch: 125%; color: var(--signal); }
  .numeros dd { margin: 4px 0 0; color: var(--ink-2); }
  .numeros-fonte { margin-top: 16px; max-width: var(--medida); color: var(--mute); font-size: 0.85rem; }
  .proximos { display: grid; gap: 10px; margin: 20px 0 0; padding: 0; list-style: none; color: var(--ink-2); }
  .proximos li { display: flex; gap: 12px; }
  .proximos li::before { content: ''; flex: none; width: 16px; height: 3px; margin-top: 0.75em; background: var(--signal); }
  .proximo { display: grid; gap: 6px; padding: clamp(22px, 4vw, 36px); background: var(--bg-2); border: 1px solid var(--line); border-radius: 14px; text-decoration: none; transition: border-color 0.25s; }
  .proximo:hover { border-color: var(--signal); }
  .proximo strong { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 850; font-stretch: 125%; }
  .proximo-frase { color: var(--ink-2); }
  @media (max-width: 639px) { .ficha { grid-template-columns: minmax(0, 1fr); } }

  /* Barra de leitura dos temas próprios: blocos de --bloco px (com --vao de folga) em --leitura-cor sobre --leitura-trilho.
     O tamanho do bloco é lido também por leitura.ts. */
  .leitura { --bloco: 18px; --vao: 3px; position: fixed; z-index: 51; left: 0; right: 0; top: calc(var(--altura-nav) - 6px); height: 6px; background: var(--leitura-trilho); pointer-events: none; }
  .leitura-cheio { display: block; height: 100%; width: var(--lido, 0px); background: repeating-linear-gradient(90deg, var(--leitura-cor) 0 calc(var(--bloco) - var(--vao)), transparent calc(var(--bloco) - var(--vao)) var(--bloco)); }
  :global(html:not(.js)) .leitura { display: none; }
  @media print { .leitura { display: none; } }
  main[data-tema='rpg'] { --leitura-trilho: var(--contorno); --leitura-cor: var(--signal); }
  /* Terminal: barra de progresso em blocos verdes estreitos, com os blocos vazios marcados de leve no trilho. */
  main[data-tema='terminal'] { --leitura-cor: var(--signal); --leitura-trilho: repeating-linear-gradient(90deg, var(--line) 0 6px, var(--bg) 6px 8px); }
  main[data-tema='terminal'] .leitura { --bloco: 8px; --vao: 2px; height: 5px; top: calc(var(--altura-nav) - 5px); }

  /* Tema rpg (as cores, a fonte e a parede ficam em tema-rpg.css). */
  main[data-tema='rpg'] .voltar { font-family: var(--fonte-pixel); }
  /* Cena do jogo: à direita do título no desktop (fora do fluxo, sem empurrar nada); no celular, logo abaixo dele. */
  main[data-tema='rpg'] .caso-topo { position: relative; }
  .caso-cena { margin-top: 18px; }
  @media (min-width: 900px) {
    .caso-cena { position: absolute; margin: 0; top: clamp(96px, 9vw, 120px); right: clamp(16px, 4vw, 40px); }
  }
  @media (max-width: 639px) { main[data-tema='rpg'] h1 { font-size: clamp(2.2rem, 12vw, 3.2rem); } }
  main[data-tema='rpg'] .caso-frase { color: var(--ink); }
  /* "Em resumo" vira a ficha do personagem: pergaminho com moldura de madeira, texto em tinta. */
  main[data-tema='rpg'] .em-resumo { margin: calc(2 * var(--px)); background: var(--pergaminho); border: 0; border-radius: 0; box-shadow: var(--moldura-pergaminho); color: var(--tinta); }
  main[data-tema='rpg'] .em-resumo-titulo { font-family: var(--fonte-pixel); font-weight: 400; letter-spacing: 0; color: var(--tinta); text-shadow: none; }
  main[data-tema='rpg'] .em-resumo-titulo::before { width: 12px; height: 12px; margin-right: 12px; background: var(--dourado-escuro); box-shadow: 0 0 0 3px var(--tinta); vertical-align: 0.1em; }
  main[data-tema='rpg'] .em-resumo-texto { color: var(--tinta); }
  main[data-tema='rpg'] .numeros dt { font-family: var(--fonte-corpo); color: #7a5210; /* sobre o pergaminho, acima de 4,5:1 */ }
  main[data-tema='rpg'] .numeros dd, main[data-tema='rpg'] .numeros-fonte { color: var(--tinta-suave); }
  /* Painéis de pedra com a moldura em pixels. */
  main[data-tema='rpg'] .arquitetura,
  main[data-tema='rpg'] .proximo { margin-inline: var(--px); border: 0; border-radius: 0; background: var(--pedra); box-shadow: var(--moldura-pedra); }
  main[data-tema='rpg'] .proximo:hover { background: var(--pedra-clara); }
  main[data-tema='rpg'] .proximo strong { font-family: var(--fonte-pixel); font-weight: 400; font-stretch: normal; color: var(--signal); }
  main[data-tema='rpg'] .funcs h3 { color: var(--ink); }
  main[data-tema='rpg'] .proximos li::before { height: 6px; width: 6px; margin-top: 0.6em; }

  /* Tema terminal (as cores e a fonte ficam em tema-terminal.css). */
  /* "Em resumo" vira uma janela de terminal: a barra de título no lugar do título visível (que fica para o leitor de tela). */
  main[data-tema='terminal'] .em-resumo { padding: 0 0 clamp(20px, 3vw, 30px); background: var(--bg-2); border: 1px solid var(--line-2); border-radius: var(--raio); overflow: hidden; }
  main[data-tema='terminal'] .em-resumo > :not(.janela-barra) { margin-inline: clamp(18px, 3vw, 30px); }
  main[data-tema='terminal'] .em-resumo-titulo { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  main[data-tema='terminal'] .em-resumo-texto { margin-top: clamp(16px, 2.4vw, 22px); }
  main[data-tema='terminal'] .numeros { gap: 14px 24px; padding-top: 18px; border-top: 1px dashed var(--line-2); }
  main[data-tema='terminal'] .numeros dt { font-family: var(--fonte-mono); font-weight: 700; font-stretch: normal; letter-spacing: -0.03em; color: var(--verde); }
  main[data-tema='terminal'] .numeros-fonte { color: var(--mute); }
  main[data-tema='terminal'] .proximo { border-radius: var(--raio); }
  main[data-tema='terminal'] .proximo strong { font-family: var(--fonte-mono); font-weight: 700; font-stretch: normal; letter-spacing: -0.03em; }
  /* O log do pipeline: ao lado do título no desktop largo (o cabeçalho vira duas colunas), logo abaixo dele no resto. */
  .caso-log { margin-top: 20px; }
  @media (min-width: 1100px) {
    main[data-tema='terminal'] .caso-topo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 470px); column-gap: 48px; align-items: start; }
    main[data-tema='terminal'] .caso-topo > * { grid-column: 1; }
    main[data-tema='terminal'] .caso-topo > .voltar { justify-self: start; }
    main[data-tema='terminal'] .caso-topo > .caso-log { grid-column: 2; grid-row: 1 / span 7; margin-top: 8px; }
  }
  /* Próximos passos como caixas de tarefa por fazer: `[ ]` em mono, posto por CSS (o texto não muda). */
  main[data-tema='terminal'] .proximos { font-size: 1rem; }
  main[data-tema='terminal'] .proximos li::before { content: '[ ]' / ''; width: auto; height: auto; margin: 0; background: none; font-family: var(--fonte-mono); color: var(--verde); white-space: pre; }
</style>
<script>import '../scripts/leitura';</script>
