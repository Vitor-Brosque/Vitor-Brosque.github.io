---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '../styles/tokens.css';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Nav from '../components/Nav.astro';
import Rodape from '../components/Rodape.astro';
import Ampliador from '../components/Ampliador.astro';
import { langHtml, t, urlEquivalente, type Idioma } from '../i18n/ui';

interface Props {
  titulo: string;
  descricao: string;
  idioma: Idioma;
  imagemOg?: ImageMetadata;
  jsonLd?: Record<string, unknown>;
  indexar?: boolean;
  altOg?: string;
}
const { titulo, descricao, idioma, imagemOg, jsonLd, indexar = true, altOg = titulo } = Astro.props;
const site = Astro.site ?? new URL('https://vitor-brosque.github.io');
const canonica = new URL(Astro.url.pathname, site).href;
const urlPt = new URL(urlEquivalente(Astro.url.pathname, 'pt'), site).href;
const urlEn = new URL(urlEquivalente(Astro.url.pathname, 'en'), site).href;
// Imagem de compartilhamento: vem de quem usa o layout (a capa do projeto). Sem ela, a página sai sem og:image.
const og = imagemOg ? await getImage({ src: imagemOg, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'png' }) : undefined;
const ogUrl = og ? new URL(og.src, site).href : undefined;
---
<!doctype html>
<html lang={langHtml(idioma)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {!indexar && <meta name="robots" content="noindex" />}
    {indexar && <link rel="canonical" href={canonica} />}
    {indexar && <link rel="alternate" hreflang="pt-BR" href={urlPt} />}
    {indexar && <link rel="alternate" hreflang="en" href={urlEn} />}
    {indexar && <link rel="alternate" hreflang="x-default" href={urlPt} />}
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#111513" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    {ogUrl && <meta property="og:image:alt" content={altOg} />}
    <meta property="og:locale" content={idioma === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      (() => {
        const marcar = () => document.documentElement.classList.add('js');
        marcar();
        document.addEventListener('astro:after-swap', marcar);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="pular" href="#conteudo">{t(idioma, 'pular')}</a>
    <Nav idioma={idioma} />
    <slot />
    <Rodape idioma={idioma} />
    <Ampliador idioma={idioma} />
  </body>
</html>
<script>
  import '../scripts/revelar';
</script>
<style>
  .pular { position: absolute; left: 16px; top: -60px; z-index: 100; padding: 10px 14px; background: var(--signal); color: var(--bg); font-weight: 700; }
  .pular:focus { top: 12px; }
</style>
