---
import EstudoDeCaso from '../../layouts/EstudoDeCaso.astro';
import { projetosDoIdioma } from '../../lib/projetos';
import { proximoDaLista, slugDe } from '../../lib/projetos-puro';

export async function getStaticPaths() {
  const lista = await projetosDoIdioma('pt');
  return lista.map((projeto, i) => ({
    params: { slug: slugDe(projeto.id) },
    props: { projeto, proximo: proximoDaLista(lista, i) },
  }));
}
const { projeto, proximo } = Astro.props;
---
<EstudoDeCaso projeto={projeto} proximo={proximo} idioma="pt" />
