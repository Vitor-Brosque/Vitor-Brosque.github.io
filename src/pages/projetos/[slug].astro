---
import EstudoDeCaso from '../../layouts/EstudoDeCaso.astro';
import { projetosDoIdioma } from '../../lib/projetos';
import { outrosDaLista, slugDe } from '../../lib/projetos-puro';

export async function getStaticPaths() {
  const lista = await projetosDoIdioma('pt');
  return lista.map((projeto, i) => ({
    params: { slug: slugDe(projeto.id) },
    props: { projeto, outros: outrosDaLista(lista, i) },
  }));
}
const { projeto, outros } = Astro.props;
---
<EstudoDeCaso projeto={projeto} outros={outros} idioma="pt" />
