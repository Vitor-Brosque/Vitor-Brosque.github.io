---
import encruzilhada from '../../assets/temas/rpg/encruzilhada.svg?raw';
import personagem from '../../assets/temas/rpg/personagem-padrao.svg?raw';
import Lanterna from './Lanterna.astro';
import { spriteInline } from '../../lib/sprite';

/**
 * Cena do cabeçalho do Life RPG: a Encruzilhada (placa e fogueira), o personagem e a lanterna, sobre um trecho de grama.
 * Tudo na mesma escala inteira (--s px por pixel do sprite), para os pixels ficarem nítidos. Decorativa.
 * Medidas em pixels do jogo: a cena tem 52 × 26; a grama começa na linha 23.
 */
---
<div class="cena" aria-hidden="true">
  <div class="cena-grama"></div>
  <div class="cena-sprite cena-encruzilhada" set:html={spriteInline(encruzilhada, 'sprite')} />
  <div class="cena-sprite cena-personagem" set:html={spriteInline(personagem, 'sprite')} />
  <div class="cena-sprite cena-lanterna"><Lanterna /></div>
</div>
<style>
  .cena { --s: 5px; position: relative; width: calc(52 * var(--s)); height: calc(26 * var(--s)); }
  .cena-sprite { position: absolute; }
  .cena-sprite :global(.sprite) { display: block; width: 100%; height: 100%; }
  .cena-encruzilhada { left: calc(15 * var(--s)); top: 0; width: calc(24 * var(--s)); height: calc(24 * var(--s)); }
  .cena-personagem { left: calc(1 * var(--s)); top: calc(7 * var(--s)); width: calc(16 * var(--s)); height: calc(16 * var(--s)); }
  .cena-lanterna { left: calc(35 * var(--s)); top: calc(3 * var(--s)); width: calc(16 * var(--s)); height: calc(16 * var(--s)); }
  /* Grama do mapa: um tom claro por cima, o verde de base e o contorno escuro, com os cantos recortados. */
  .cena-grama {
    position: absolute; left: 0; right: 0; top: calc(22 * var(--s)); bottom: 0;
    background: #4f8f45; border-top: var(--s) solid #5ea152;
    box-shadow: 0 var(--s) 0 #1a1220, calc(-1 * var(--s)) 0 0 #1a1220, var(--s) 0 0 #1a1220, 0 calc(-1 * var(--s)) 0 #1a1220;
  }
  @media (max-width: 639px) { .cena { --s: 4px; } }
  @media (min-width: 900px) { .cena { --s: 6px; } }
  @media (min-width: 1100px) { .cena { --s: 7px; } }
</style>
