---
import CarrinhoPixel from './CarrinhoPixel.astro';
import Lanterna from './rpg/Lanterna.astro';
import { t, type Idioma, type Tema } from '../i18n/ui';
interface Props { carro?: boolean; idioma?: Idioma; tema?: Tema }
const { carro = false, idioma = 'pt', tema = 'rodovia' } = Astro.props;
// Cada tema próprio troca a pista: a trilha de terra do mapa do jogo (rpg) ou o duto com os pacotes de dados (terminal).
// Essas páginas têm loops próprios (a chama, o cursor), por isso a faixa delas leva o botão de pausa.
const variante = { rodovia: null, rpg: 'trilha', terminal: 'duto' }[tema];
const comPausa = carro || variante !== null;
// Nome próprio para este botão: o da rota já se chama "Pausar", e dois botões com o mesmo nome confundem no leitor de tela.
const pausar = t(idioma, 'animacoes.pausar');
---
{/* A pista é decorativa (aria-hidden); na estrada com botão de pausa ele fica fora da parte escondida do leitor de tela. */}
<div class:list={['estrada', { 'estrada--carro': carro }, variante && `estrada--${variante}`]} data-estrada aria-hidden={comPausa ? undefined : 'true'}>
  {carro && <div class="estrada-carro" aria-hidden="true"><CarrinhoPixel /></div>}
  {/* Na trilha do rpg a lanterna fica no lugar, como o carro da estrada do topo da home: quem corre é a trilha. */}
  {variante === 'trilha' && <div class="estrada-carro estrada-lanterna" aria-hidden="true"><Lanterna /></div>}
  {comPausa && (
    <button type="button" class="estrada-pausa" data-estrada-pausa data-pausar={pausar} data-continuar={t(idioma, 'animacoes.continuar')} aria-label={pausar}>
      <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" shape-rendering="crispEdges">
        <g class="icone-pausar"><rect x="2" y="1" width="3" height="10" /><rect x="7" y="1" width="3" height="10" /></g>
        <path class="icone-continuar" d="M3 1h2v1h2v1h2v1h2v4h-2v1h-2v1h-2v1h-2z" />
      </svg>
    </button>
  )}
</div>
<style>
  .estrada { --desloc: 0px; position: relative; height: 56px; background: var(--estrada); border-block: 2px solid var(--line); overflow: hidden; }
  .estrada--carro { height: 84px; }
  .estrada::after {
    content: '';
    position: absolute; inset-inline: 0; top: 50%;
    height: 4px; margin-top: -2px;
    background: repeating-linear-gradient(90deg, var(--signal) 0 40px, transparent 40px 68px);
    background-position-x: var(--desloc);
  }
  /* Na estrada com carro, tachões nas duas bordas da pista passam junto com o tracejado (mesmo --desloc; 34 px divide os 68 do tracejado). */
  .estrada--carro::before {
    content: '';
    position: absolute; inset-inline: 0; inset-block: 9px;
    background:
      linear-gradient(90deg, rgb(236 240 236 / 0.3) 0 12px, transparent 12px) var(--desloc) 0 / 34px 3px repeat-x,
      linear-gradient(90deg, rgb(236 240 236 / 0.3) 0 12px, transparent 12px) var(--desloc) 100% / 34px 3px repeat-x;
  }
  /* O carro fica no lugar (12% da largura; 14% no celular): quem corre é a rua. */
  .estrada-carro { position: absolute; z-index: 1; top: 50%; left: 12%; width: 92px; height: 50px; margin: -27px 0 0 -46px; }
  .estrada-carro :global(.carrinho) { position: relative; z-index: 1; filter: drop-shadow(0 4px 0 rgb(0 0 0 / 0.5)); }
  /* Farol aceso nos dois modos. */
  .estrada-carro::after { content: ''; position: absolute; left: 92%; top: 22%; width: 150%; height: 70%; background: linear-gradient(90deg, rgb(255 246 204 / 0.42), transparent); clip-path: polygon(0 38%, 100% 0, 100% 100%, 0 62%); }
  @media (max-width: 639px) { .estrada-carro { left: 14%; } }
  /* A lanterna em escala inteira (16 × 16 em escala 3), sem o farol do carro; a chama e o pulinho seguem as regras de movimento. */
  .estrada-lanterna { width: 48px; height: 48px; margin: -27px 0 0 -24px; }
  .estrada-lanterna::after { display: none; }
  .estrada-lanterna :global(.lanterna) { position: relative; z-index: 1; filter: drop-shadow(0 3px 0 rgb(11 12 20 / 0.6)); }
  /* Pausa da página (pausa.ts), no canto direito da pista, sobre o tracejado: uma placa pequena, só com ícone. Sem JS não aparece. */
  .estrada-pausa {
    position: absolute; z-index: 2; top: 50%; right: clamp(10px, 2.4vw, 24px); width: 34px; height: 34px; margin-top: -17px; padding: 0;
    display: grid; place-items: center; border: 1px solid rgb(236 240 236 / 0.28); border-radius: 4px; background: var(--estrada);
    color: rgb(236 240 236 / 0.8); cursor: pointer; transition: border-color 0.2s, color 0.2s, background-color 0.2s;
  }
  .estrada-pausa svg { fill: currentColor; }
  .estrada-pausa:hover { border-color: var(--signal); color: var(--signal); }
  .estrada-pausa:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .estrada-pausa[data-pausada] { border-color: var(--signal); background: var(--signal-fundo); color: var(--signal); }
  .estrada-pausa .icone-continuar,
  .estrada-pausa[data-pausada] .icone-pausar { display: none; }
  .estrada-pausa[data-pausada] .icone-continuar { display: inline; }
  :global(html:not(.js)) .estrada-pausa { display: none; }
  /* Trilha do tema rpg: terra sobre grama, com as cores do mapa do jogo. Tudo corre junto com o mesmo --desloc
     (cada desenho repete em 34 ou 17 px, divisores dos 68 px do período da rua; ver estrada-calculo.ts). */
  .estrada--trilha {
    /* A trilha anda de pixel em pixel do jogo (3 px), sem borrar os pontos. */
    --d: var(--desloc);
    height: 60px; border-block: 3px solid var(--contorno);
    background:
      /* pedrinhas da terra (pontos de 3 px, como as estradas do mapa) */
      linear-gradient(90deg, var(--terra-clara) 3px, transparent 3px) calc(var(--d) + 5px) 21px / 34px 3px repeat-x,
      linear-gradient(90deg, var(--terra-clara) 3px, transparent 3px) calc(var(--d) + 22px) 33px / 34px 3px repeat-x,
      linear-gradient(90deg, var(--terra-escura) 3px, transparent 3px) calc(var(--d) + 13px) 27px / 34px 3px repeat-x,
      linear-gradient(90deg, var(--estrada-pedra) 3px, transparent 3px) calc(var(--d) + 29px) 24px / 34px 3px repeat-x,
      /* tufos de grama clara e escura */
      linear-gradient(90deg, var(--grama-clara) 3px, transparent 3px) calc(var(--d) + 9px) 6px / 34px 3px repeat-x,
      linear-gradient(90deg, var(--grama-escura) 3px, transparent 3px) calc(var(--d) + 26px) 3px / 34px 3px repeat-x,
      linear-gradient(90deg, var(--grama-clara) 3px, transparent 3px) calc(var(--d) + 18px) 45px / 34px 3px repeat-x,
      linear-gradient(90deg, var(--grama-escura) 3px, transparent 3px) calc(var(--d) + 3px) 48px / 34px 3px repeat-x,
      linear-gradient(90deg, var(--grama-clara) 3px, transparent 3px) calc(var(--d) + 31px) 51px / 34px 3px repeat-x,
      /* a trilha, com a borda de grama escura, sobre a grama */
      linear-gradient(var(--grama-escura) 0 0) 0 15px / 100% 3px no-repeat,
      linear-gradient(var(--grama-escura) 0 0) 0 39px / 100% 3px no-repeat,
      linear-gradient(var(--terra) 0 0) 0 18px / 100% 21px no-repeat,
      var(--grama);
  }
  /* Sem round() no navegador a trilha anda em frações de pixel, mas não some. */
  @supports (width: round(1px, 3px)) {
    .estrada--trilha { --d: round(var(--desloc), 3px); }
  }
  .estrada--trilha::after { display: none; }
  .estrada--trilha .estrada-pausa {
    width: 36px; height: 36px; margin-top: -18px; border: 0; border-radius: 0; background: var(--pedra); color: var(--ink);
    box-shadow: var(--moldura-pedra);
  }
  .estrada--trilha .estrada-pausa:hover { background: var(--pedra-clara); color: var(--signal); }
  .estrada--trilha .estrada-pausa:focus-visible { outline: 3px solid var(--signal); outline-offset: 3px; }
  .estrada--trilha .estrada-pausa[data-pausada] { background: var(--signal); color: var(--tinta); box-shadow: 0 -3px 0 var(--contorno), 0 3px 0 var(--contorno), -3px 0 0 var(--contorno), 3px 0 0 var(--contorno), inset 0 -3px 0 var(--dourado-escuro); }

  /* Duto do tema terminal: um tubo fino com pacotes de dados correndo com o mesmo --desloc. O desenho só pode repetir a
     cada 68 px (o período da rua), por isso o âmbar é um pacote curto entre três verdes. */
  .estrada--duto {
    height: 44px; border-block: 1px solid var(--line);
    background:
      linear-gradient(90deg, var(--verde) 12px, transparent 12px) calc(var(--desloc) + 4px) 18px / 68px 6px repeat-x,
      linear-gradient(90deg, var(--verde) 6px, transparent 6px) calc(var(--desloc) + 24px) 18px / 68px 6px repeat-x,
      linear-gradient(90deg, var(--verde) 9px, transparent 9px) calc(var(--desloc) + 38px) 18px / 68px 6px repeat-x,
      linear-gradient(90deg, var(--ambar) 4px, transparent 4px) calc(var(--desloc) + 56px) 18px / 68px 6px repeat-x,
      linear-gradient(var(--line-2) 0 0) 0 11px / 100% 1px no-repeat,
      linear-gradient(var(--line-2) 0 0) 0 30px / 100% 1px no-repeat,
      linear-gradient(var(--bg-2) 0 0) 0 12px / 100% 18px no-repeat,
      var(--bg);
  }
  .estrada--duto::after { display: none; }
  .estrada--duto .estrada-pausa { width: 30px; height: 30px; margin-top: -15px; border: 1px solid var(--line-2); border-radius: var(--raio); background: var(--bg); color: var(--ink-2); }
  .estrada--duto .estrada-pausa:hover { border-color: var(--verde); color: var(--verde); }
  .estrada--duto .estrada-pausa:focus-visible { outline: 3px solid var(--verde); outline-offset: 2px; }
  .estrada--duto .estrada-pausa[data-pausada] { border-color: var(--verde); background: var(--verde-fundo); color: var(--verde); }

  @media (prefers-reduced-motion: no-preference) {
    .estrada-carro :global(.carrinho) { animation: quicar-estrada 0.26s steps(2) infinite; }
    /* Pulinho de 3 px (um pixel do jogo) da lanterna na trilha, só com movimento permitido. */
    .estrada-lanterna :global(.lanterna) { animation: pular-trilha 0.5s steps(1) infinite; }
    @keyframes pular-trilha { 50% { translate: 0 -3px; } }
    @keyframes quicar-estrada { 50% { translate: 0 -1px; } }
  }
</style>
<script>import '../scripts/estrada';</script>
