---
import Rota from '../Rota.astro';
import type { Projeto } from '../../lib/projetos';
import { slugDe } from '../../lib/projetos-puro';
import { t, urlDoProjeto, type Idioma } from '../../i18n/ui';

interface Props { idioma: Idioma; projeto: Projeto }
const { idioma, projeto } = Astro.props;
const d = projeto.data;
const slug = slugDe(projeto.id);
---
<section id="projetos" class="secao wrap destaque" aria-labelledby="destaque-titulo">
  <p class="rotulo rotulo--sinal revelar">01 · {d.statusTexto}</p>
  <h2 id="destaque-titulo" transition:name={`titulo-${slug}`}>{d.titulo}</h2>
  <p class="destaque-frase revelar">{d.frase}</p>
  {d.statusDetalhe && <p class="destaque-nota revelar">{d.statusDetalhe}</p>}
  <div class="resumo">
    <div class="revelar"><p class="rotulo">{t(idioma, 'destaque.problema')}</p><p>{d.resumo.problema}</p></div>
    <div class="revelar resumo--sinal"><p class="rotulo">{t(idioma, 'destaque.construi')}</p><p>{d.resumo.construi}</p></div>
    <div class="revelar"><p class="rotulo">{t(idioma, 'destaque.orgulho')}</p><p>{d.resumo.orgulho}</p></div>
  </div>
  <div class="destaque-rota revelar">
    <Rota titulo={d.rota.titulo} paradas={d.rota.paradas} modo="loop" idioma={idioma} />
  </div>
  <a class="botao botao--sinal destaque-cta" href={urlDoProjeto(idioma, slug)}>{t(idioma, 'card.verCaso')} <span class="seta" aria-hidden="true">→</span></a>
</section>
<style>
  h2 { margin-top: 10px; font-size: clamp(2.5rem, 5vw, 3.5rem); }
  .destaque-frase { margin-top: 12px; color: var(--mute); font-size: 1.05rem; }
  .destaque-nota { margin-top: 8px; max-width: var(--medida); color: var(--mute); font-size: 0.95rem; }
  .resumo { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 32px; }
  .resumo > div { border-top: 3px solid var(--line-2); padding-top: 12px; color: var(--ink-2); }
  .resumo > div.resumo--sinal { border-top-color: var(--signal); }
  .resumo .rotulo { margin-bottom: 6px; }
  .destaque-rota { margin-top: 36px; }
  .destaque-cta { margin-top: 32px; }
  @media (max-width: 899px) {
    .resumo { grid-template-columns: 1fr; }
  }
</style>
