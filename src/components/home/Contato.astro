---
import { GITHUB, LINKEDIN, textosHome } from '../../i18n/home';
import type { Idioma } from '../../i18n/ui';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const c = textosHome[idioma].contato;
---
<section id="contato" class="secao wrap" aria-labelledby="contato-titulo">
  <div class="contato revelar">
    <h2 id="contato-titulo">{c.titulo}</h2>
    <p>{c.texto}</p>
    <div class="acoes">
      <a class="botao botao--sinal" href={LINKEDIN} rel="me">{c.linkedin}</a>
      <a class="botao" href={GITHUB} rel="me">{c.github}</a>
    </div>
  </div>
</section>
<style>
  .contato { padding: clamp(28px, 5vw, 56px); background: var(--estrada); border: 1px solid var(--line); border-radius: 14px; }
  .contato p { margin-top: 14px; max-width: var(--medida); color: var(--ink-2); }
  .acoes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
</style>
