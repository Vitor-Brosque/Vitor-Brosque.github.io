---
import { Picture } from 'astro:assets';
import Rota from '../Rota.astro';
import Lanterna from '../rpg/Lanterna.astro';
import '@fontsource/pixelify-sans/latin-400.css';
import type { Projeto } from '../../lib/projetos';
import { slugDe } from '../../lib/projetos-puro';
import { t, urlDoProjeto, type Idioma } from '../../i18n/ui';

interface Props { idioma: Idioma; projeto: Projeto; numero: number }
const { idioma, projeto, numero } = Astro.props;
const d = projeto.data;
const slug = slugDe(projeto.id);
const usaCapa = d.cartao === 'capa' && d.capa?.imagem;
/**
 * Cartão de projeto com tema próprio: o do Life RPG (moldura em pixels do jogo, fonte pixel e a lanterna num canto da imagem)
 * e o do TechNews (moldura de terminal, título em mono e a rota compacta com o cursor e "Etapa n").
 */
const rpg = d.tema === 'rpg';
---
<article class:list={['card', 'revelar', d.tema !== 'rodovia' && `card--${d.tema}`]}>
  <div class:list={['card-midia', { 'card-midia--rota': !usaCapa }]}>
    {usaCapa && d.capa?.imagem ? (
      <Picture src={d.capa.imagem} alt="" formats={['avif', 'webp']} widths={[480, 780]} sizes="(min-width: 900px) 34vw, 92vw" />
    ) : (
      <Rota titulo={d.rota.titulo} paradas={d.rota.paradas} idioma={idioma} compacta tema={d.tema} />
    )}
    {rpg && <div class="card-lanterna" aria-hidden="true"><Lanterna /></div>}
  </div>
  <div class="card-corpo">
    <p class="rotulo"><span class:list={['ponto', `ponto--${d.status}`]} aria-hidden="true"></span>{String(numero).padStart(2, '0')} · {d.statusTexto}</p>
    <h3 transition:name={`titulo-${slug}`}><a class="card-link" href={urlDoProjeto(idioma, slug)}>{d.titulo}</a></h3>
    <p class="card-frase">{d.frase}</p>
    <span class="card-mais" aria-hidden="true">{t(idioma, 'card.verCaso')} <span class="seta">→</span></span>
  </div>
</article>
<style>
  /* A transição repete a da revelação (.revelar), que esta regra sobrescreve: fade e, com movimento, subida. */
  /* O cartão padrão declara as cores da rodovia (as mesmas de tokens.css): ele leva a cara do próprio projeto e não
     herda as cores redefinidas pelo tema da página onde aparece (o fim dos estudos de caso). Na home nada muda. */
  .card {
    --bg: #111513; --bg-2: #171c19; --surface: #1e2522; --line: #26302b; --line-2: #34403b;
    --ink: #ecefea; --ink-2: #c9d2ce; --mute: #9aa6a0; --signal: #f5b800; --ok: #2e9e5b;
    --asfalto: #0c0f0e; --signal-fundo: #262410; --signal-hover: #ffcb2e; --raio: 10px;
    color: var(--ink);
  }
  .card { position: relative; display: flex; flex-direction: column; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--raio); overflow: hidden; transition: border-color 0.25s, box-shadow 0.25s, opacity 0.7s var(--ease), translate 0.5s var(--ease), scale 0.8s var(--ease); transition-delay: calc(var(--ordem, 0) * 70ms); }
  .card:hover, .card:focus-within { border-color: var(--signal); box-shadow: 0 18px 40px -24px rgb(245 184 0 / 0.35); }
  .card-mais { transition: color 0.2s; }
  .card:hover .card-mais, .card:focus-within .card-mais { color: var(--signal-hover); }
  .seta { display: inline-block; transition: translate 0.25s var(--ease); }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover, .card:focus-within { translate: 0 -6px; }
    .card-midia :global(img) { transition: scale 0.5s var(--ease); }
    .card:hover .card-midia :global(img), .card:focus-within .card-midia :global(img) { scale: 1.04; }
    .card:hover .seta, .card:focus-within .seta { translate: 4px 0; }
  }
  .card-midia { height: 220px; overflow: hidden; background: #0d100f; }
  .card-midia :global(picture) { display: block; height: 100%; }
  .card-midia :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 44%; }
  .card-midia--rota { display: flex; align-items: center; height: auto; min-height: 190px; padding: 18px; }
  .card-midia--rota :global(.rota) { width: 100%; }
  .card-corpo { padding: 18px 18px 20px; }
  .ponto { display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--ok); }
  .ponto--desenvolvimento { background: var(--signal); }
  h3 { margin-top: 6px; font-size: 1.45rem; }
  .card-link { text-decoration: none; }
  .card-link::after { content: ''; position: absolute; inset: 0; }
  .card-frase { margin-top: 6px; color: var(--ink-2); font-size: 0.95rem; }
  .card-mais { display: inline-block; margin-top: 12px; color: var(--signal); font-weight: 700; font-size: 0.9rem; }

  /* Tema rpg (Life RPG): moldura em pixels do jogo (contorno com os cantos recortados e o chanfro de pedra),
     cantos retos e o título na Pixelify Sans. As cores são as do jogo ("noite na taverna"). */
  .card--rpg {
    /* A home fica fora do <main data-tema="rpg">: as cores do jogo vêm declaradas aqui, uma vez. */
    --px: 3px;
    --rpg-noite: #12141f;
    --rpg-noite-2: #1b1e2e;
    --rpg-pedra: #2a2e45;
    --rpg-pedra-clara: #3b4063;
    --rpg-contorno: #0b0c14;
    --rpg-ouro: #f2c14e;
    --rpg-moldura: 0 calc(-1 * var(--px)) 0 var(--rpg-contorno), 0 var(--px) 0 var(--rpg-contorno),
      calc(-1 * var(--px)) 0 0 var(--rpg-contorno), var(--px) 0 0 var(--rpg-contorno);
    overflow: visible; border-color: transparent; border-radius: 0; background: var(--rpg-noite-2);
    box-shadow: var(--rpg-moldura), inset var(--px) var(--px) 0 var(--rpg-pedra-clara), inset calc(-1 * var(--px)) calc(-1 * var(--px)) 0 var(--rpg-noite);
  }
  .card--rpg:hover, .card--rpg:focus-within {
    box-shadow: 0 calc(-1 * var(--px)) 0 var(--rpg-ouro), 0 var(--px) 0 var(--rpg-ouro), calc(-1 * var(--px)) 0 0 var(--rpg-ouro), var(--px) 0 0 var(--rpg-ouro),
      inset var(--px) var(--px) 0 var(--rpg-pedra-clara), inset calc(-1 * var(--px)) calc(-1 * var(--px)) 0 var(--rpg-noite);
  }
  /* A moldura fica por fora (sombras): o cartão mede o mesmo que antes e o resto da home não se mexe. */
  .card--rpg .card-midia { position: relative; border-bottom: var(--px) solid var(--rpg-contorno); background: var(--rpg-noite); }
  .card--rpg h3 { font-family: 'Pixelify Sans', system-ui, sans-serif; font-weight: 400; font-stretch: normal; letter-spacing: 0; font-variant-ligatures: none; font-size: 1.75rem; line-height: calc(1.45rem * 1.15); /* a mesma altura de linha do título dos outros cartões */ }
  .card--rpg .card-link:hover { color: var(--rpg-ouro); text-decoration: none; }
  /* A lanterna (16 × 16, em escala 3) numa plaquinha de pedra no canto de baixo da imagem; a chama alterna os quadros só com movimento permitido. */
  .card-lanterna {
    position: absolute; right: 12px; bottom: 12px; z-index: 1; box-sizing: content-box; width: 48px; height: 48px; padding: 6px;
    background: var(--rpg-pedra);
    box-shadow: var(--rpg-moldura), inset var(--px) var(--px) 0 var(--rpg-pedra-clara), inset calc(-1 * var(--px)) calc(-1 * var(--px)) 0 var(--rpg-noite-2);
  }

  /* Tema terminal (TechNews): a home fica fora do <main data-tema="terminal">, então as cores do tema vêm declaradas aqui,
     uma vez, com os mesmos nomes (a rota compacta usa os mesmos tokens da página). Borda de 1 px e cantos quase retos. */
  .card--terminal {
    --bg: #0a0d0a; --bg-2: #0f140f; --surface: #131a13; --line: #1f2a1f; --line-2: #2c3b2c;
    --ink: #d7e3d4; --ink-2: #b5c4b1; --mute: #8a9c86; --signal: #7ee787; --signal-hover: #a7f0ad; --signal-fundo: #122012;
    --verde: #7ee787; --ambar: #e3b341; --verde-fundo: #122012; --asfalto: #070a07; --raio: 2px;
    background: var(--bg-2); border-color: var(--line-2); color: var(--ink);
  }
  .card--terminal:hover, .card--terminal:focus-within { border-color: var(--verde); box-shadow: none; }
  .card--terminal .card-midia { background: var(--bg); }
  .card--terminal h3 { font-family: var(--fonte-mono); font-weight: 700; font-stretch: normal; letter-spacing: -0.03em; line-height: calc(1.45rem * 1.15); }
</style>
