---
import { Picture } from 'astro:assets';
import Estrada from '../Estrada.astro';
import type { Projeto } from '../../lib/projetos';
import { LINKEDIN, textosHome } from '../../i18n/home';
import type { Idioma } from '../../i18n/ui';

interface Props { idioma: Idioma; destaque: Projeto }
const { idioma, destaque } = Astro.props;
const h = textosHome[idioma].hero;
const capa = destaque.data.capa;
const locale = idioma === 'pt' ? 'pt-BR' : 'en-US';
const formato = new Intl.NumberFormat(locale);
---
<div class="primeira-dobra">
  <header class="hero wrap">
    <div class="hero-texto">
      <span class="selo" data-entrada style="--ordem: 0">{h.selo}</span>
      <h1 data-hero-titulo>{h.tituloAntes}<em>{h.tituloDestaque}</em>{h.tituloDepois}</h1>
      <p class="hero-apresentacao" data-entrada style="--ordem: 3">{h.apresentacao}</p>
      <div class="hero-acoes" data-entrada style="--ordem: 4">
        <a class="botao botao--sinal" href="#projetos">{h.ctaPrincipal} <span class="seta seta--baixo" aria-hidden="true">↓</span></a>
        <a class="botao" href={LINKEDIN} rel="me">{h.ctaLinkedin}</a>
      </div>
    </div>
    <ul class="numeros">
      {h.numeros.map((n, i) => (
        <li data-hero-prova data-entrada style={`--ordem: ${5 + i}`}>
          <strong class="numero">
            <span class="sr-only">{(n.prefixo ?? '') + formato.format(n.numero) + (n.sufixo ?? '')}</span>
            <span class="numero-reserva" aria-hidden="true">{(n.prefixo ?? '') + formato.format(n.numero) + (n.sufixo ?? '')}</span>
            <span aria-hidden="true" data-contar={n.numero} data-prefixo={n.prefixo ?? ''} data-sufixo={n.sufixo ?? ''} data-locale={locale}>{(n.prefixo ?? '') + formato.format(n.numero) + (n.sufixo ?? '')}</span>
          </strong>
          <span class="rotulo-numero">{n.rotulo}</span>
        </li>
      ))}
    </ul>
    {capa?.imagem && (
      <div class="hero-visual">
        <div class="hero-halo" aria-hidden="true"></div>
        <figure class="hero-print" data-hero-print>
          <div class="hero-print-barra" aria-hidden="true"><i></i><i></i><i></i></div>
          <Picture src={capa.imagem} alt={capa.alt} formats={['avif', 'webp']} widths={[480, 800, 1100]} sizes="(min-width: 900px) 42vw, 92vw" loading="eager" fetchpriority="high" />
          <figcaption>{h.rotuloPrint}</figcaption>
        </figure>
      </div>
    )}
  </header>
  <Estrada carro />
</div>
<style>
  .hero {
    overflow-x: clip; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: 'texto' 'numeros' 'print';
    gap: clamp(28px, 6vw, 44px); align-items: center; padding-block: clamp(36px, 7vw, 72px) clamp(48px, 8vw, 80px);
  }
  .hero-texto { grid-area: texto; }
  .numeros { grid-area: numeros; }
  .hero-visual { grid-area: print; }
  .selo { display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px; background: var(--signal); color: var(--bg); font-family: var(--fonte-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .selo::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--bg); }
  @media (prefers-reduced-motion: no-preference) { .selo::before { animation: piscar 1.4s infinite; } }
  @keyframes piscar { 50% { opacity: 0.2; } }
  h1 { margin-top: 20px; font-size: clamp(2.3rem, 7.4vw, 4.1rem); line-height: 0.97; }
  h1 em { font-style: normal; color: var(--signal); }
  .hero-apresentacao { margin-top: 20px; max-width: 52ch; color: var(--ink-2); font-size: clamp(1rem, 1.4vw, 1.125rem); }
  .hero-acoes { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }

  /* Faixa de números de ponta a ponta: linha em cima e embaixo, separador entre os itens. */
  .numeros { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border-block: 1px solid var(--line-2); }
  .numeros li { padding: 16px clamp(14px, 2.2vw, 28px); }
  .numeros li:first-child { padding-left: 0; }
  .numeros li + li { border-left: 1px solid var(--line-2); }
  .numero { flex: none; font-size: clamp(1.9rem, 3.4vw, 3rem); white-space: nowrap; font-weight: 850; font-stretch: 125%; line-height: 1; color: var(--signal); font-variant-numeric: tabular-nums; }
  /* A largura do número é a do valor final (cópia invisível na mesma célula): a contagem não empurra o rótulo. */
  .numero { display: grid; justify-items: start; }
  .numero > * { grid-area: 1 / 1; }
  .numero-reserva { visibility: hidden; }
  .rotulo-numero { display: block; margin-top: 6px; max-width: 32ch; color: var(--ink-2); font-size: 0.9rem; line-height: 1.28; }

  .hero-visual { position: relative; isolation: isolate; }
  /* Halo amarelo difuso atrás do print: parado com movimento reduzido, respirando com movimento. */
  .hero-halo { position: absolute; z-index: -1; inset: -28% -22%; background: radial-gradient(closest-side, rgb(245 184 0 / 0.3), rgb(245 184 0 / 0.12) 50%, transparent); filter: blur(20px); pointer-events: none; }
  .hero-print { position: relative; margin: 0; rotate: 1.5deg; border: 1px solid #2e3833; border-radius: var(--raio); overflow: hidden; background: #fff; box-shadow: 0 34px 70px -24px #000, 0 0 0 7px var(--estrada); }
  .hero-print-barra { display: flex; gap: 5px; align-items: center; height: 22px; padding-left: 10px; background: var(--surface); }
  .hero-print-barra i { width: 7px; height: 7px; border-radius: 50%; background: #3a4642; }
  .hero-print :global(img) { width: 100%; height: clamp(240px, 60vw, 400px); object-fit: cover; object-position: top; }
  .hero-print figcaption { position: absolute; left: 14px; bottom: 14px; padding: 7px 11px; background: var(--ink); color: var(--bg); font-weight: 700; font-size: 0.8rem; font-stretch: 110%; }

  /* Entrada do print (com o halo) por CSS, no invólucro: o print usa rotate (repouso), translate (flutuar) e transform (inclinação por GSAP). */
  .hero-visual { animation: print-surgir 0.9s var(--ease) 0.15s both; }
  @keyframes print-surgir { from { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .hero-visual { animation-name: print-chegar; animation-duration: 1.2s; }
    @keyframes print-chegar { from { opacity: 0; translate: 0 60px; rotate: 8deg; scale: 0.94; } }
    .hero-print { animation: flutuar 7s ease-in-out infinite; }
    .hero-halo { animation: respirar 6s ease-in-out infinite; }
  }
  @keyframes flutuar { 50% { translate: 0 -8px; } }
  @keyframes respirar { 50% { opacity: 0.55; } }

  /* Celular: cada número vira uma linha, com o número numa coluna fixa e o rótulo ao lado. */
  @media (max-width: 639px) {
    .numeros { grid-template-columns: minmax(0, 1fr); }
    .numeros li { display: grid; grid-template-columns: 9.2rem minmax(0, 1fr); align-items: center; gap: 12px; padding: 12px 0; }
    .numeros li + li { border-left: 0; border-top: 1px solid var(--line-2); }
    .numero { font-size: 1.75rem; }
    .rotulo-numero { margin-top: 0; max-width: none; font-size: 0.9rem; }
  }

  /* Desktop: a primeira dobra é o hero mais a estrada colada no pé; as medidas também respeitam a altura da janela. */
  @media (min-width: 900px) {
    .primeira-dobra { display: flex; flex-direction: column; min-height: min(calc(100svh - var(--altura-nav)), 880px); }
    .primeira-dobra > :global(.estrada) { flex: none; }
    .hero {
      flex: 1 0 auto; align-content: center;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); grid-template-areas: 'texto print' 'numeros numeros';
      column-gap: clamp(28px, 4vw, 56px); row-gap: clamp(16px, 2.8svh, 44px);
      padding-block: clamp(12px, 2.4svh, 48px);
    }
    h1 { margin-top: clamp(12px, 2.4svh, 22px); font-size: clamp(2.3rem, min(5.2vw, 7svh), 4.1rem); }
    /* O título em inglês quebra em cinco linhas (contra quatro em português): um pouco menor para a dobra caber. */
    h1:lang(en) { font-size: clamp(2.3rem, min(4.8vw, 6.2svh), 3.8rem); }
    .hero-apresentacao { margin-top: clamp(12px, 2.4svh, 22px); }
    .hero-acoes { margin-top: clamp(16px, 2.8svh, 30px); }
    .hero-print { rotate: 2.5deg; }
    .hero-print :global(img) { height: clamp(220px, min(32vw, 46svh), 400px); }
    /* Colunas proporcionais ao conteúdo: o segundo número e o rótulo dele são os mais longos e o terceiro número tem um dígito só. */
    .numeros { grid-template-columns: minmax(0, 1.27fr) minmax(0, 1.45fr) minmax(0, 0.78fr); }
    .numeros li { display: flex; align-items: center; gap: clamp(12px, 1.4vw, 18px); padding-block: clamp(10px, 1.8svh, 18px); }
    .numero { font-size: clamp(2rem, min(2.9vw, 5svh), 2.6rem); font-stretch: 112%; }
    .rotulo-numero { margin-top: 0; }
  }
</style>
<script>import '../../scripts/hero';</script>
