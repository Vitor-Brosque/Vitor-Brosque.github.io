---
import { textoRico } from '../lib/texto';
import { t, type Idioma } from '../i18n/ui';
interface Props {
  idioma: Idioma;
  decisao: { titulo: string; escolha: string; porque: string; deixeiDeLado: string };
}
const { idioma, decisao } = Astro.props;
---
<article class="decisao revelar">
  <h3>{decisao.titulo}</h3>
  <p class="rotulo">{t(idioma, 'caso.escolhi')}</p>
  <p set:html={textoRico(decisao.escolha)} />
  <p class="rotulo">{t(idioma, 'caso.porque')}</p>
  <p set:html={textoRico(decisao.porque)} />
  <details>
    <summary>{t(idioma, 'caso.deixei')}</summary>
    <p set:html={textoRico(decisao.deixeiDeLado)} />
  </details>
</article>
<style>
  .decisao { display: flex; flex-direction: column; gap: 6px; padding: 20px; background: var(--bg-2); border: 1px solid var(--line); border-top: 3px solid var(--signal); border-radius: var(--raio); color: var(--ink-2); }
  h3 { margin-bottom: 8px; color: var(--ink); }
  .rotulo { margin-top: 8px; }
  details { margin-top: 12px; border-top: 1px dashed var(--line-2); padding-top: 10px; }
  summary { cursor: pointer; font-weight: 700; color: var(--signal); }
  details p { margin-top: 8px; }
  @supports (interpolate-size: allow-keywords) {
    details { interpolate-size: allow-keywords; }
    details::details-content { height: 0; overflow: clip; transition: height 0.3s var(--ease), content-visibility 0.3s allow-discrete; }
    details[open]::details-content { height: auto; }
  }
</style>
