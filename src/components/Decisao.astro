---
import agora from '../assets/temas/rpg/agora.svg?raw';
import { spriteInline } from '../lib/sprite';
import { textoRico } from '../lib/texto';
import { t, type Idioma, type Tema } from '../i18n/ui';
interface Props {
  idioma: Idioma;
  decisao: { titulo: string; resumo: string; escolha: string; porque: string; deixeiDeLado: string };
  /** No tema rpg a decisão vira um cartão de missão do jogo, com a espada do ícone "Agora" ao lado do título. */
  tema?: Tema;
}
const { idioma, decisao, tema = 'rodovia' } = Astro.props;
const rpg = tema === 'rpg';
/** Cada tema próprio tem o seu cartão: a missão do jogo (rpg) ou o bloco de terminal (terminal). */
const variante = { rodovia: null, rpg: 'missao', terminal: 'terminal' }[tema];
---
<details class:list={['decisao', 'recolhivel', 'revelar', variante && `decisao--${variante}`]}>
  <summary>
    <span class="resumo-titulo">{rpg && <span class="missao-icone" set:html={spriteInline(agora, 'icone')} />}{decisao.titulo}</span>
    <span class="resumo-texto">{decisao.resumo}</span>
    <span class="resumo-icone" aria-hidden="true"></span>
  </summary>
  <div class="corpo recolhivel-corpo">
    <p class="rotulo">{t(idioma, 'caso.escolhi')}</p>
    <p set:html={textoRico(decisao.escolha)} />
    <p class="rotulo">{t(idioma, 'caso.porque')}</p>
    <p set:html={textoRico(decisao.porque)} />
    <p class="rotulo">{t(idioma, 'caso.deixei')}</p>
    <p set:html={textoRico(decisao.deixeiDeLado)} />
  </div>
</details>
<style>
  .decisao { background: var(--bg-2); border: 1px solid var(--line); border-top: 3px solid var(--signal); border-radius: var(--raio); color: var(--ink-2); }
  .corpo { display: flex; flex-direction: column; gap: 6px; max-width: var(--medida); padding: 4px clamp(16px, 3vw, 24px) 22px; }
  .rotulo { margin-top: 10px; }

  /* Cartão de missão (tema rpg): pedra com a moldura em pixels; aberto, o conteúdo vem em pergaminho. */
  .decisao--missao { margin-inline: var(--px); border: 0; background: var(--pedra); box-shadow: var(--moldura-pedra); }
  .decisao--missao .resumo-titulo { display: flex; align-items: center; gap: 10px; font-size: 1.2rem; }
  .missao-icone { flex: none; width: 24px; height: 24px; color: var(--signal); }
  .missao-icone :global(.icone) { display: block; width: 100%; height: 100%; }
  .decisao--missao .corpo {
    --ink-2: var(--tinta); --mute: var(--tinta-suave); --surface: var(--pergaminho-escuro); --line: var(--pergaminho-escuro);
    max-width: none; margin: 0 clamp(12px, 2.4vw, 20px) clamp(16px, 2.4vw, 20px); padding: 6px clamp(14px, 2.4vw, 22px) 18px;
    background: var(--pergaminho); color: var(--tinta); box-shadow: var(--moldura-pergaminho);
  }
  .decisao--missao .corpo p { max-width: var(--medida); }
  .decisao--missao .corpo .rotulo { color: var(--tinta-suave); }

  /* Bloco de terminal (tema terminal): título em mono com um marcador verde; aberto, o conteúdo vem como saída
     (fundo um pouco mais claro e a borda esquerda verde). */
  .decisao--terminal { border: 1px solid var(--line-2); border-radius: var(--raio); }
  .decisao--terminal .resumo-titulo { font-size: 1.02rem; font-weight: 700; letter-spacing: -0.02em; }
  .decisao--terminal .resumo-titulo::before { content: '▸ ' / ''; color: var(--verde); }
  .decisao--terminal .corpo {
    max-width: none; margin: 0 clamp(12px, 2.4vw, 20px) clamp(14px, 2.4vw, 18px); padding: 4px clamp(14px, 2.4vw, 20px) 16px;
    background: var(--surface); border-left: 2px solid var(--verde); border-radius: var(--raio);
  }
  .decisao--terminal .corpo p { max-width: var(--medida); }
</style>
