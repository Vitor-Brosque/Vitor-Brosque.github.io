---
import Base from '../layouts/Base.astro';
import Estrada from './Estrada.astro';
import Hero from './home/Hero.astro';
import Destaque from './home/Destaque.astro';
import OutrosProjetos from './home/OutrosProjetos.astro';
import Trajetoria from './home/Trajetoria.astro';
import Ferramentas from './home/Ferramentas.astro';
import Contato from './home/Contato.astro';
import { projetosDoIdioma } from '../lib/projetos';
import { GITHUB, LINKEDIN, textosHome } from '../i18n/home';
import { urlDaHome, type Idioma } from '../i18n/ui';

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const projetos = await projetosDoIdioma(idioma);
const destaque = projetos.find((p) => p.data.destaque) ?? projetos[0];
if (!destaque) throw new Error(`Nenhum projeto em ${idioma}.`);
const outros = projetos.filter((p) => p !== destaque);
const h = textosHome[idioma];
const site = Astro.site ?? new URL('https://vitor-brosque.github.io');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vitor Brosque',
  url: new URL(urlDaHome(idioma), site).href,
  jobTitle: idioma === 'pt' ? 'Estudante de Sistemas de Informação · Backend e Dados' : 'Information Systems student · Backend and Data',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'UNESP' },
  address: { '@type': 'PostalAddress', addressLocality: 'Bauru', addressRegion: 'SP', addressCountry: 'BR' },
  sameAs: [LINKEDIN, GITHUB],
};
---
<Base titulo={h.meta.titulo} descricao={h.meta.descricao} idioma={idioma} imagemOg={destaque.data.capa?.imagem} altOg={destaque.data.capa?.alt} jsonLd={jsonLd}>
  <main id="conteudo">
    <Hero idioma={idioma} destaque={destaque} />
    <Estrada />
    <Destaque idioma={idioma} projeto={destaque} />
    <OutrosProjetos idioma={idioma} projetos={outros} />
    <Trajetoria idioma={idioma} />
    <Ferramentas idioma={idioma} />
    <Contato idioma={idioma} />
  </main>
</Base>
