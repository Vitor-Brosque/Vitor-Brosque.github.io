---
import { t, type Idioma } from '../i18n/ui';
interface Props { idioma: Idioma }
const { idioma } = Astro.props;
---
<dialog class="ampliador" data-ampliador aria-label={t(idioma, 'midia.ampliar')}>
  <button type="button" class="ampliador-fechar" data-fechar aria-label={t(idioma, 'midia.fechar')}>×</button>
  <img alt="" />
</dialog>
<style>
  /* O diálogo não rola: a borda entra na conta e a imagem cabe inteira nele, limitada pela janela, sem deformar. */
  .ampliador { box-sizing: border-box; max-width: min(96vw, 1400px); max-height: 92vh; padding: 0; overflow: hidden; border: 1px solid var(--line-2); border-radius: var(--raio); background: var(--bg); color: var(--ink); }
  .ampliador::backdrop { background: rgb(8 10 9 / 0.85); }
  .ampliador img { display: block; width: auto; height: auto; max-width: calc(min(96vw, 1400px) - 2px); max-height: calc(92vh - 2px); object-fit: contain; margin-inline: auto; }
  .ampliador-fechar { position: absolute; top: 8px; right: 8px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: var(--bg); color: var(--ink); font-size: 1.5rem; cursor: pointer; }
</style>
<script>import '../scripts/ampliar';</script>
