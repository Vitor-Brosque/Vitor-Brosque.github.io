---
import CarrinhoPixel from './CarrinhoPixel.astro';
import MolduraMidia from './MolduraMidia.astro';
import type { Parada } from '../lib/projetos';
import { textoRico } from '../lib/texto';
import { t, type Idioma } from '../i18n/ui';

interface Props {
  titulo: string;
  paradas: Parada[];
  modo: 'loop' | 'rolagem';
  idioma: Idioma;
  compacta?: boolean;
}
const { titulo, paradas, modo, idioma, compacta = false } = Astro.props;
/** A rota grande da home: placas que são botões e, embaixo, a vitrine com a tela de cada parada. */
const vitrine = modo === 'loop' && !compacta;
---
<div
  class:list={['rota', { 'rota--compacta': compacta, 'rota--vitrine': vitrine }]}
  data-rota
  data-modo={modo}
  style={`--n: ${paradas.length}`}
  role="group"
  aria-label={titulo}
>
  {vitrine && (
    <div class="rota-topo">
      <div class="rota-titulo">
        <span class="rotulo">{titulo}</span>
        <span class="rota-dica">{t(idioma, 'rota.dica')}</span>
      </div>
      <div class="rota-controles">
        <span class="rotulo rotulo--sinal ao-vivo" aria-hidden="true"><i class="ponto-vivo"></i>{t(idioma, 'rota.aoVivo')}</span>
        <button type="button" class="rota-pausa" data-rota-pausa data-pausar={t(idioma, 'rota.pausar')} data-continuar={t(idioma, 'rota.continuar')}>{t(idioma, 'rota.pausar')}</button>
      </div>
    </div>
  )}
  <div class="rota-palco">
    <ol class="placas">
      {paradas.map((p, i) => (
        <li class="placa" data-ativa={i === 0 ? '' : undefined}>
          {vitrine ? (
            <button type="button" class="placa-corpo" data-placa-botao>
              <span class="km">KM {i}</span>
              <strong class="placa-titulo">{p.titulo}</strong>
              <span class="placa-texto" set:html={textoRico(p.curto ?? p.texto)} />
            </button>
          ) : (
            <div class="placa-corpo">
              <span class="km">KM {i}</span>
              <strong class="placa-titulo">{p.titulo}</strong>
            </div>
          )}
          <div class="poste" aria-hidden="true"></div>
          {modo === 'rolagem' && (
            <div class:list={['rota-detalhe', { 'rota-detalhe--midia': p.midia }]}>
              <div class="rota-detalhe-corpo">
                {/* KM e título repetem a placa: só aparecem no painel da rota presa e o leitor de tela não os ouve de novo. */}
                <span class="rota-detalhe-km" aria-hidden="true">KM {i}</span>
                <strong class="rota-detalhe-titulo" aria-hidden="true">{p.titulo}</strong>
                <p class="rota-detalhe-texto" set:html={textoRico(p.texto)} />
              </div>
              {p.midia
                ? <MolduraMidia midia={p.midia} idioma={idioma} sizes="(min-width: 900px) 40vw, 90vw" />
                : <span class="rota-detalhe-marco" aria-hidden="true">KM {i}</span>}
            </div>
          )}
        </li>
      ))}
    </ol>
    <div class="asfalto" aria-hidden="true"><div class="carro"><CarrinhoPixel /></div></div>
  </div>
  {vitrine && (
    <div class="vitrine" data-vitrine>
      {paradas.map((p, i) => (
        <div class:list={['rota-detalhe', 'vitrine-painel', { 'rota-detalhe--midia': p.midia }]} data-painel data-ativa={i === 0 ? '' : undefined}>
          <div class="rota-detalhe-corpo">
            <span class="rota-detalhe-km">KM {i}</span>
            <h3 class="rota-detalhe-titulo">{p.titulo}</h3>
            <p class="rota-detalhe-texto" set:html={textoRico(p.texto)} />
          </div>
          {p.midia
            ? <MolduraMidia midia={p.midia} idioma={idioma} sizes="(min-width: 900px) 55vw, 92vw" />
            : <span class="rota-detalhe-marco" aria-hidden="true">KM {i}</span>}
        </div>
      ))}
    </div>
  )}
</div>

<style>
  .rota { --pos: 0.1; --feito: 0; --area: min(52vh, 460px); background: var(--bg-2); border: 1px solid var(--line); border-radius: 12px; padding: 18px clamp(14px, 2vw, 22px) 22px; }
  .rota--vitrine { --area: clamp(300px, 46vh, 440px); }
  .rota--compacta { background: transparent; border: 0; padding: 0; }
  .rota-topo { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; margin-bottom: 14px; }
  .rota-topo > * { white-space: nowrap; }
  .rota-titulo { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .rota-dica { font: 500 0.72rem/1.2 var(--fonte-mono); letter-spacing: 0.04em; color: var(--mute); }
  :global(html:not(.js)) .rota-dica { display: none; }
  .rota-controles { display: flex; align-items: center; gap: 12px; margin-left: auto; }
  .ao-vivo { display: inline-flex; align-items: center; gap: 7px; transition: color 0.3s; }
  .ponto-vivo { width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 3px rgb(245 184 0 / 0.18); transition: box-shadow 0.3s; }
  .rota[data-pausada] .ao-vivo { color: var(--mute); }
  .rota[data-pausada] .ponto-vivo { box-shadow: none; }
  .rota-pausa { min-height: 32px; padding: 4px 12px; border: 1px solid var(--line-2); border-radius: 4px; background: transparent; color: var(--ink-2); font: 700 0.72rem/1 var(--fonte-mono); letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer;
    /* Largura fixa: trocar Pausar por Continuar não mexe no resto da linha. */
    min-width: 6.75rem; transition: border-color 0.2s, color 0.2s, background-color 0.2s; }
  .rota-pausa:hover { border-color: var(--signal); color: var(--signal); }
  .rota[data-pausada] .rota-pausa { border-color: var(--signal); background: var(--signal-fundo); color: var(--signal); }
  :global(html:not(.js)) .rota-pausa { display: none; }

  .placas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 12px; }
  .placa-corpo { display: block; height: 100%; background: var(--surface); border: 2px solid var(--line-2); border-radius: 6px; padding: 10px 12px 12px; transition: border-color 0.3s, background-color 0.3s, box-shadow 0.3s, translate 0.4s var(--ease); }
  .placa[data-ativa] .placa-corpo { border-color: var(--signal); background: var(--signal-fundo); box-shadow: 0 0 0 4px rgb(245 184 0 / 0.12), 0 10px 24px -12px rgb(245 184 0 / 0.45); }
  /* Na rota grande a placa é um botão: leva o carro até ela e mostra a tela da parada. */
  button.placa-corpo { width: 100%; margin: 0; font: inherit; color: inherit; text-align: left; cursor: pointer; }
  button.placa-corpo:hover { border-color: rgb(245 184 0 / 0.6); }
  button.placa-corpo:focus-visible { outline: 3px solid var(--signal); outline-offset: 3px; }
  .km { display: block; font-family: var(--fonte-mono); font-size: 0.7rem; letter-spacing: 0.08em; color: var(--mute); transition: color 0.3s; }
  .placa[data-ativa] .km, button.placa-corpo:hover .km { color: var(--signal); }
  .placa-titulo { display: block; margin-top: 4px; font-stretch: 115%; font-weight: 800; font-size: 1rem; line-height: 1.2; }
  .placa-texto { display: block; margin-top: 6px; font-size: 0.86rem; line-height: 1.45; color: var(--mute); transition: color 0.3s; }
  .placa[data-ativa] .placa-texto { color: var(--ink-2); }
  .rota--compacta .placas { gap: 6px; }
  .rota--compacta .placa-corpo { padding: 6px 6px; }
  .rota--compacta .placa-titulo { font-size: 0.74rem; }
  .poste { width: 4px; height: 16px; margin-left: 22px; background: var(--line-2); transition: background-color 0.3s; }
  .placa[data-ativa] .poste { background: var(--signal); }
  .rota--compacta .poste { height: 10px; margin-left: 14px; }

  .asfalto { position: relative; height: 60px; border-radius: 4px; background: var(--asfalto); overflow: hidden; }
  .rota--compacta .asfalto { height: 42px; }
  /* Tracejado apagado e, por cima, o trecho já percorrido (do início até o carro). */
  .asfalto::before { content: ''; position: absolute; inset-inline: 0; top: 50%; height: 3px; margin-top: -1.5px; background: repeating-linear-gradient(90deg, rgb(245 184 0 / 0.32) 0 26px, transparent 26px 44px); }
  .asfalto::after { content: ''; position: absolute; left: 0; top: 50%; width: calc(var(--feito) * 100%); height: 3px; margin-top: -1.5px; background: var(--signal); box-shadow: 0 0 10px rgb(245 184 0 / 0.5); }
  .carro { position: absolute; z-index: 1; top: 50%; left: calc(var(--pos) * 100%); width: 66px; height: 36px; translate: -50% -55%; transition: opacity 0.2s; }
  .carro :global(.carrinho) { position: relative; z-index: 1; filter: drop-shadow(0 3px 0 rgb(0 0 0 / 0.55)); }
  .rota--compacta .carro { width: 48px; height: 26px; }
  .rota[data-trocando] .carro { opacity: 0; }
  /* Farol: cone de luz à frente do carro, mais forte quando ele anda. */
  .carro::after { content: ''; position: absolute; left: 92%; top: 22%; width: 120%; height: 70%; background: linear-gradient(90deg, rgb(255 246 204 / 0.4), transparent); clip-path: polygon(0 38%, 100% 0, 100% 100%, 0 62%); opacity: 0.55; transition: opacity 0.3s; }
  .rota[data-andando] .carro::after { opacity: 1; }
  .rota[data-estatico] .carro { display: none; }

  /* Painel de uma parada, o mesmo na vitrine da home e na rota presa do estudo de caso:
     KM em mono amarelo, título grande, o texto completo e a mídia ao lado. */
  .rota-detalhe-km { display: block; font-family: var(--fonte-mono); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.12em; color: var(--signal); }
  .rota-detalhe-titulo { display: block; margin-top: 8px; font-size: clamp(1.45rem, 2.6vw, 2.2rem); font-weight: 850; font-stretch: 120%; line-height: 1.05; }
  .rota-detalhe-texto { color: var(--ink-2); max-width: 52ch; }
  .vitrine .rota-detalhe-texto { margin-top: 10px; font-size: 1rem; line-height: 1.5; }
  /* Parada sem mídia: um marco grande, só de contorno, no lugar dela. */
  .rota-detalhe-marco {
    display: block; justify-self: end; white-space: nowrap; font-size: clamp(5.5rem, 11vw, 9rem); font-weight: 900; font-stretch: 125%; line-height: 0.9; letter-spacing: -0.01em;
    color: transparent; -webkit-text-stroke: 2px var(--line-2); user-select: none;
  }
  /* No estudo de caso, KM, título e marco repetem a placa: só aparecem no painel da rota presa (ver a media query de 900 px). */
  .rota[data-modo='rolagem'] .rota-detalhe-km,
  .rota[data-modo='rolagem'] .rota-detalhe-titulo,
  .rota[data-modo='rolagem'] .rota-detalhe-marco { display: none; }
  /* A mídia de qualquer painel aparece inteira: cabe na largura e, onde há área de altura fixa, na altura, mantendo a proporção.
     --ar vem de MolduraMidia; --bx e --by descontam bordas e a barra do navegador; --alto é a altura disponível
     (a da área, quando o quadro tem altura fixa; sem contêiner de altura, cqh vale a altura da janela). */
  .rota-detalhe :global(.moldura) { margin-top: 14px; container-type: inline-size; }
  .rota-detalhe :global(.moldura-tela) { --bx: 2px; --by: 2px; width: fit-content; max-width: none; margin-inline: auto; }
  .rota-detalhe :global(.moldura--navegador .moldura-tela) { --by: 27px; }
  .rota-detalhe :global(.moldura--celular .moldura-tela) { --bx: 16px; --by: 16px; }
  /* Recorte sem moldura (só a peça da tela): borda fina, cantos arredondados e um pouco menor que a área, para não parecer ampliado. */
  .rota-detalhe :global(.moldura--nenhuma .moldura-tela) { --by: calc(2px + 16cqh); border: 1px solid var(--line-2); box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8); }
  .rota-detalhe :global(.moldura-midia) { width: min(100cqw - var(--bx), (var(--alto, 100cqh) - var(--by)) * var(--ar, 1.6)); }

  /* Vitrine (rota grande da home): um painel por parada, todos na mesma célula do grid, para a altura não mudar na troca.
     Sem JavaScript, os painéis ficam um embaixo do outro, todos visíveis. */
  .vitrine { margin-top: 22px; }
  :global(.js) .vitrine { display: grid; }
  :global(.js) .vitrine-painel { grid-area: 1 / 1; opacity: 0; visibility: hidden; transition: opacity 0.35s, visibility 0.35s; }
  :global(.js) .vitrine-painel[data-ativa] { opacity: 1; visibility: visible; }
  :global(html:not(.js)) .vitrine { display: grid; gap: 28px; }
  :global(html:not(.js)) .vitrine-painel + .vitrine-painel { padding-top: 28px; border-top: 1px solid var(--line); }
  .vitrine-painel { display: grid; grid-template-rows: auto 1fr; align-items: start; gap: 16px; }
  .vitrine .rota-detalhe :global(.moldura) { margin: 0; height: var(--area); container-type: size; display: grid; place-items: start center; }
  /* Na vitrine o vídeo usa os controles nativos (e a tela inteira deles); o botão próprio ficaria por cima da barra. */
  .vitrine :global(.moldura-play) { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .placa[data-ativa] .placa-corpo { translate: 0 -4px; }
    .asfalto::before { animation: tracejar 0.5s linear infinite paused; }
    .rota[data-andando] .asfalto::before { animation-play-state: running; }
    .rota[data-andando] .carro :global(.carrinho) { animation: quicar 0.24s steps(2) infinite; }
    .rota:not([data-pausada]) .ponto-vivo { animation: piscar-vivo 1.4s infinite; }
    /* O painel que aparece sobe uns 14 px (o fade vale nos dois modos). */
    :global(.js) .vitrine-painel { translate: 0 14px; transition: opacity 0.35s, visibility 0.35s, translate 0.45s var(--ease); }
    :global(.js) .vitrine-painel[data-ativa] { translate: none; }
    @keyframes tracejar { to { background-position-x: -44px; } }
    @keyframes quicar { 50% { translate: 0 -1px; } }
    @keyframes piscar-vivo { 50% { opacity: 0.25; } }
  }

  @media (max-width: 559px) {
    .rota--compacta .placa-titulo { display: none; }
  }

  @media (max-width: 899px) {
    /* Rota grande no celular: seis botões só com o KM, a estrada horizontal embaixo e a vitrine em seguida. */
    .rota--vitrine { --area: clamp(280px, 48vh, 400px); }
    .rota--vitrine .placas { gap: 6px; }
    .rota--vitrine .placa-corpo { display: grid; place-items: center; min-height: 40px; padding: 6px 2px; }
    .rota--vitrine .km { font-size: 0.74rem; letter-spacing: 0.04em; }
    .rota--vitrine .placa-titulo,
    .rota--vitrine .placa-texto { display: none; }
    .rota--vitrine .poste { height: 10px; margin-inline: auto; }
    .rota--vitrine .asfalto { height: 46px; }
    .rota--vitrine .carro { width: 48px; height: 26px; }

    .rota[data-modo='rolagem'] .rota-palco { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 14px; }
    .rota[data-modo='rolagem'] .placas { grid-column: 2; grid-row: 1; grid-template-columns: 1fr; gap: 16px; }
    .rota[data-modo='rolagem'] .asfalto { grid-column: 1; grid-row: 1; height: auto; }
    .rota[data-modo='rolagem'] .asfalto::before { inset-inline: auto; left: 50%; top: 0; bottom: 0; width: 3px; height: auto; margin: 0 0 0 -1.5px; background: repeating-linear-gradient(180deg, rgb(245 184 0 / 0.32) 0 26px, transparent 26px 44px); }
    .rota[data-modo='rolagem'] .asfalto::after { left: 50%; top: 0; width: 3px; height: calc(var(--feito) * 100%); margin: 0 0 0 -1.5px; }
    .rota[data-modo='rolagem'] .carro { left: 50%; top: calc(var(--pos) * 100%); width: 58px; height: 32px; rotate: 90deg; translate: -50% -50%; }
    .rota[data-modo='rolagem'] .poste { display: none; }
    .rota[data-modo='rolagem'] .rota-detalhe { margin-top: 10px; }
    /* No celular o detalhe fica dentro da placa: o quadro passa a ser o próprio li. */
    .rota[data-modo='rolagem'] .placa { background: var(--surface); border: 2px solid var(--line-2); border-radius: 6px; padding: 10px 12px 14px; transition: border-color 0.3s, background-color 0.3s, box-shadow 0.3s; }
    .rota[data-modo='rolagem'] .placa[data-ativa],
    :global(html:not(.js)) .rota[data-modo='rolagem'] .placa { border-color: var(--signal); background: var(--signal-fundo); box-shadow: 0 0 0 4px rgb(245 184 0 / 0.12); }
    .rota[data-modo='rolagem'] .placa-corpo { height: auto; padding: 0; border: 0; background: none; box-shadow: none; }
  }
  @media (max-width: 899px) and (prefers-reduced-motion: no-preference) {
    .rota[data-modo='rolagem'] .placa[data-ativa] .placa-corpo { translate: none; }
    .rota[data-modo='rolagem'] .asfalto::before { animation-name: tracejar-vertical; }
    @keyframes tracejar-vertical { to { background-position-y: 44px; } }
  }

  @media (min-width: 900px) {
    /* Vitrine no desktop: texto à esquerda, mídia à direita. */
    .vitrine-painel { grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); grid-template-rows: none; align-items: center; gap: 32px; }
    .vitrine .rota-detalhe :global(.moldura) { place-items: center; }
    .vitrine .rota-detalhe-texto,
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .rota-detalhe-texto { margin-top: 16px; font-size: 1.15rem; line-height: 1.55; }

    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .rota-palco { position: relative; padding-bottom: calc(var(--area) + 24px); }
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .rota-detalhe {
      position: absolute; inset-inline: 0; bottom: 0; height: var(--area);
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); align-items: center; gap: 28px;
      opacity: 0; visibility: hidden; transition: opacity 0.35s, visibility 0.35s;
    }
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .placa[data-ativa] .rota-detalhe { opacity: 1; visibility: visible; }
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .rota-detalhe-km,
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .rota-detalhe-titulo,
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .rota-detalhe-marco { display: block; }
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .rota-detalhe--midia { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    /* A mídia do painel ocupa a área de altura fixa e cabe inteira nela (rota presa, estática ou sem JS). */
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .rota-detalhe :global(.moldura) { margin: 0; height: var(--area); container-type: size; display: grid; place-items: center; }
    /* Na lista (estática ou sem JS) a mídia cabe na mesma altura, mas o quadro fica do tamanho dela, alinhado ao texto. */
    .rota[data-modo='rolagem'][data-estatico] .rota-detalhe :global(.moldura),
    :global(html:not(.js)) .rota[data-modo='rolagem'] .rota-detalhe :global(.moldura) { margin: 0; --alto: var(--area); }

    .rota[data-modo='rolagem'][data-estatico] .placas,
    :global(html:not(.js)) .rota[data-modo='rolagem'] .placas { grid-template-columns: 1fr; }
    .rota[data-modo='rolagem'][data-estatico] .asfalto,
    .rota[data-modo='rolagem'][data-estatico] .poste,
    :global(html:not(.js)) .rota[data-modo='rolagem'] .poste,
    :global(html:not(.js)) .rota[data-modo='rolagem'] .asfalto { display: none; }
    /* Estático (movimento reduzido) ou sem JS no desktop: o quadro é o li, para o detalhe ficar dentro da placa.
       Com movimento reduzido só acende a placa no meio da janela; sem JS todas ficam acesas. */
    .rota[data-modo='rolagem'][data-estatico] .placa,
    :global(html:not(.js)) .rota[data-modo='rolagem'] .placa { padding: 12px 16px 16px; background: var(--surface); border: 2px solid var(--line-2); border-radius: 6px; transition: border-color 0.3s, background-color 0.3s, box-shadow 0.3s; }
    .rota[data-modo='rolagem'][data-estatico] .placa[data-ativa],
    :global(html:not(.js)) .rota[data-modo='rolagem'] .placa { background: var(--signal-fundo); border-color: var(--signal); box-shadow: 0 0 0 4px rgb(245 184 0 / 0.12); }
    .rota[data-modo='rolagem'][data-estatico] .placa-corpo,
    :global(html:not(.js)) .rota[data-modo='rolagem'] .placa-corpo { height: auto; padding: 0; border: 0; background: none; box-shadow: none; translate: none; }
    .rota[data-modo='rolagem'][data-estatico] .rota-detalhe--midia,
    :global(html:not(.js)) .rota[data-modo='rolagem'] .rota-detalhe--midia { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; margin-top: 12px; align-items: start; }
  }
  /* O detalhe da parada que acende sobe uns 14 px enquanto aparece (o fade vale nos dois modos). */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .rota-detalhe { translate: 0 14px; transition: opacity 0.35s, visibility 0.35s, translate 0.45s var(--ease); }
    :global(.js) .rota[data-modo='rolagem']:not([data-estatico]) .placa[data-ativa] .rota-detalhe { translate: none; }
  }
</style>
<script>import '../scripts/rota';</script>
