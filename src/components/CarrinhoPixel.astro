---
interface Props { class?: string }
const { class: classe } = Astro.props;
---
<svg class:list={['carrinho', classe]} viewBox="0 0 22 12" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
  <rect x="6" y="1" width="9" height="1" fill="#F5B800" />
  <rect x="5" y="2" width="11" height="2" fill="#F5B800" />
  <rect x="6" y="2" width="3" height="2" fill="#9FD3FF" />
  <rect x="11" y="2" width="4" height="2" fill="#9FD3FF" />
  <rect x="1" y="4" width="20" height="4" fill="#F5B800" />
  <rect x="1" y="7" width="20" height="1" fill="#C99600" />
  <rect x="20" y="5" width="1" height="1" fill="#FFF6CC" />
  <rect x="1" y="5" width="1" height="1" fill="#E2502C" />
  <rect x="3" y="8" width="4" height="3" fill="#0B0E0D" />
  <rect x="15" y="8" width="4" height="3" fill="#0B0E0D" />
  <rect x="4" y="9" width="2" height="1" fill="#6F7B75" />
  <rect x="16" y="9" width="2" height="1" fill="#6F7B75" />
</svg>
<style>
  .carrinho { width: 100%; height: 100%; }
</style>
